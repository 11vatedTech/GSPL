{
  "schema": "gspl.textual-language.grammar-contract",
  "schemaVersion": "1.0",
  "languageVersion": "gspl-text/1.0",
  "unicodeProfileVersion": "15.1.0",
  "newlineForms": [
    "LF",
    "CRLF",
    "CR",
    "U+2028",
    "U+2029"
  ],
  "commentDelimiters": {
    "line": "//",
    "block": [
      "/*",
      "*/"
    ],
    "documentation": [
      "/**",
      "*/"
    ]
  },
  "nestedCommentPolicy": "enabled-with-bounded-depth",
  "documentationCommentPolicy": "allowed-on-declarations-and-EOF",
  "identifierPolicy": {
    "version": "gspl-id/1.0",
    "firstIdentifierRejectsSupplementaryPlane": true,
    "defaultScriptRegistryVersion": "15.1.0",
    "asciiFastPathEquivalentToFullAnalysis": true
  },
