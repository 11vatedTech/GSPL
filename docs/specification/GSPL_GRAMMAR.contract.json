  "literalWords": [
    {
      "lexeme": "true",
      "SyntaxKind": "KeywordTrue",
      "classification": "BooleanLiteral"
    },
    {
      "lexeme": "false",
      "SyntaxKind": "KeywordFalse",
      "classification": "BooleanLiteral"
    },
    {
      "lexeme": "none",
      "SyntaxKind": "KeywordNone",
      "classification": "AbsenceLiteral"
    }
  ],
  "punctuation": [
    {
      "lexeme": "{",
      "SyntaxKind": "LeftBrace"
    },
    {
      "lexeme": "}",
      "SyntaxKind": "RightBrace"
    },
    {
      "lexeme": "[",
      "SyntaxKind": "LeftBracket"
    },
    {
      "lexeme": "]",
      "SyntaxKind": "RightBracket"
    },
    {
      "lexeme": "(",
      "SyntaxKind": "LeftParen"
    },
    {
      "lexeme": ")",
      "SyntaxKind": "RightParen"
    },
    {
      "lexeme": ",",
      "SyntaxKind": "Comma"
    },
    {
      "lexeme": ":",
      "SyntaxKind": "Colon"
    },
    {
      "lexeme": "::",
      "SyntaxKind": "DoubleColon"
    },
    {
      "lexeme": ".",
      "SyntaxKind": "Dot"
    },
    {
      "lexeme": "..",
      "SyntaxKind": "DotDot"
    },
    {
      "lexeme": "@",
      "SyntaxKind": "At"
    },
    {
      "lexeme": "->",
      "SyntaxKind": "Arrow"
    },
    {
      "lexeme": "?",
      "SyntaxKind": "Question"
    },
    {
      "lexeme": ";",
      "SyntaxKind": "Semicolon"
    }
  ],
  "operators": [
    {
      "lexeme": "=",
      "SyntaxKind": "Assign"
    },
    {
      "lexeme": "+",
      "SyntaxKind": "Plus"
    },
    {
      "lexeme": "-",
      "SyntaxKind": "Minus"
    },
    {
      "lexeme": "*",
      "SyntaxKind": "Star"
    },
    {
      "lexeme": "/",
      "SyntaxKind": "Slash"
    },
    {
      "lexeme": "%",
      "SyntaxKind": "Percent"
    },
    {
      "lexeme": "!",
      "SyntaxKind": "Bang"
    },
    {
      "lexeme": "==",
      "SyntaxKind": "EqualEqual"
    },
    {
      "lexeme": "!=",
      "SyntaxKind": "BangEqual"
    },
    {
      "lexeme": "<",
      "SyntaxKind": "Less"
    },
    {
      "lexeme": "<=",
      "SyntaxKind": "LessEqual"
    },
    {
      "lexeme": ">",
      "SyntaxKind": "Greater"
    },
    {
      "lexeme": ">=",
      "SyntaxKind": "GreaterEqual"
    },
    {
      "lexeme": "&&",
      "SyntaxKind": "LogicalAnd"
    },
    {
      "lexeme": "||",
      "SyntaxKind": "LogicalOr"
    },
    {
      "lexeme": "..",
      "SyntaxKind": "Range"
    },
    {
      "lexeme": "in",
      "SyntaxKind": "In"
    }
  ],
  "expressionPrecedence": [
    {
      "rank": 1,
      "ops": [
        "||"
      ]
    },
    {
      "rank": 2,
      "ops": [
        "&&"
      ]
    },
    {
      "rank": 3,
      "ops": [
        "==",
        "!=",
        "in"
      ]
    },
    {
      "rank": 4,
      "ops": [
        "<",
        "<=",
        ">",
        ">="
      ]
    },
    {
      "rank": 5,
      "ops": [
        ".."
      ]
    },
    {
      "rank": 6,
      "ops": [
        "+",
        "-"
      ]
    },
    {
      "rank": 7,
      "ops": [
        "*",
        "/",
        "%"
      ]
    },
    {
      "rank": 8,
      "ops": [
        "!"
      ]
    }
  ],
  "triviaOwnershipVersion": "gspl-trivia/1.0",
  "diagnosticCodes": [
    "GSPL-PARSE-UNKNOWN-DOMAIN",
    "GSPL-PARSE-UNKNOWN-GENE-TYPE",
    "GSPL-PARSE-CONFIDENCE-OUT-OF-RANGE",
    "GSPL-PARSE-UNKNOWN-ENTROPY-ALGORITHM",
    "GSPL-PARSE-INVALID-EFFECT-VALUE",
    "GSPL-PARSE-MISSING-REQUIRED-CAPABILITY",
    "GSPL-PARSE-EXPECTED-TOKEN",
    "GSPL-PARSE-UNEXPECTED-EOF",
    "GSPL-PARSE-DUPLICATE-CLAUSE",
    "GSPL-PARSE-INTEGER-OVERFLOW"
  ],
  "parserNodeKinds": [
    "CompilationUnit",
    "ModuleDeclaration",
    "ImportDeclaration",
    "ExportDeclaration",
    "SeedDeclaration",
    "DomainDeclaration",
    "IntentDeclaration",
    "GeneDeclaration",
    "ConstraintBlock",
    "EntropyBlock",
    "EffectsBlock",
    "BudgetBlock",
    "TargetDeclaration",
    "ExtensionDeclaration",
    "TypeExpression",
    "Expression",
    "Block"
  ],
  "losslessDesugaring": {
    "contract": "deterministic-ordered-canonical-field-order",
    "variantsAreSortedLexicographically": true,
    "effectsFlattenedToEffectPermissions": true,
    "nonAuthorFieldsDerivedAtLowering": [
      "identity.contentId",
      "identity.lineageId",
      "lineage.generation",
      "provenance.author",
      "provenance.tool",
      "provenance.compilerVersion",
      "provenance.canonVersion"
    ],
    "triviaPreservedInASTNo": true,
    "triviaPreservedInCSTYes": true,
    "formattingRoundTripStable": true
  },
  "languageVersioning": {
    "current": "1.0",
    "versionLiteralGrammar": "major.minor",
    "wildcardsNotAccepted": true,
    "languageProfileDetection": "by-version-literal-clause"
  },
  "nestedCommentBoundedDepth": 64,
  "nestedCommentGovernedBy": "SourceLimits.maxCommentNestingDepth"
}
