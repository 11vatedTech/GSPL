{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@gspl/text-source": ["./packages/text-source/src/index.ts"],
      "@gspl/text-source/*": ["./packages/text-source/src/*"],
      "@gspl/syntax-tree": ["./packages/syntax-tree/src/index.ts"],
      "@gspl/syntax-tree/*": ["./packages/syntax-tree/src/*"],
      "@gspl/compiler-core": ["./packages/compiler-core/src/index.ts"],
      "@gspl/compiler-core/*": ["./packages/compiler-core/src/*"],
      "@gspl/package-resolver": ["./packages/package-resolver/src/index.ts"],
      "@gspl/package-resolver/*": ["./packages/package-resolver/src/*"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "tools/*/src/**/*.ts", "tools/*/test/**/*.ts", "scripts/**/*.ts", "scripts/**/*.mts", "tests/**/*.ts"],
  "exclude": ["node_modules", "**/dist", "**/coverage", "**/.vite"]
}
