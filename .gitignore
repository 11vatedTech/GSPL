# Build outputs and dependencies — never track
node_modules/
**/node_modules/
packages/*/node_modules/
tools/*/node_modules/
dist/
**/dist/
packages/*/dist/
tools/*/dist/

# Test/build caches
.vite/
**/.vite/
node_modules/.vite/
coverage/
**/coverage/
.vite-cache/
.turbo/
.next/
.nyc_output/
.cache/

# TypeScript build info
*.tsbuildinfo
**/*.tsbuildinfo

# Logs and runtime artifacts
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files (but allow .env.example)
.env
.env.local
.env.*.local
!.env.example

# Editor/OS metadata
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# Source-packaging artifacts.
# `artifacts/` is intentionally tracked: it holds canonical-validation outputs
# (e.g., `artifacts/validation/*.json`) that downstream consumers verify. Any
# future `artifacts/<X>/` scratch or cache subdirectory must be registered
# here explicitly to keep canon baseline paths clean.
build/
**/build/

# Local-only Run scripts
run-*.sh
run-*.cmd
run-*.bat

# Provisional: ignore macOS/Windows noise
._*
desktop.ini

# Project-internal: not for tracking
Reference-repos_and_planning/

# Dynamic restart/runtime subdirs are NOT tracked.
artifacts/validation/restart-*/
artifacts/validation/runtime-*/
artifacts/validation/tmp-*/
# The rest of artifacts/validation/ IS tracked (governed canonical manifests).
!artifacts/validation/canonical-output-manifest.json
!artifacts/validation/canonical-output-manifest.json.sha256
!artifacts/validation/canonical-output-manifest-*.json
!artifacts/validation/canonical-output-manifest-*.json.sha256
!artifacts/validation/source-archive-manifest.json
!artifacts/validation/source-archive-manifest.json.sha256
!artifacts/validation/source-archive-manifest-*.json
!artifacts/validation/source-archive-manifest-*.json.sha256
