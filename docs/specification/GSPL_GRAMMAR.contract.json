    },
    {
      "lexeme": "as",
      "SyntaxKind": "KeywordAs"
    },
    {
      "lexeme": "export",
      "SyntaxKind": "KeywordExport"
    },
    {
      "lexeme": "private",
      "SyntaxKind": "KeywordPrivate"
    },
    {
      "lexeme": "gene",
      "SyntaxKind": "KeywordGene"
    },
    {
      "lexeme": "confidence",
      "SyntaxKind": "KeywordConfidence"
    },
    {
      "lexeme": "invariant",
      "SyntaxKind": "KeywordInvariant"
    },
    {
      "lexeme": "constraints",
      "SyntaxKind": "KeywordConstraints"
    },
    {
      "lexeme": "require",
      "SyntaxKind": "KeywordRequire"
    },
    {
