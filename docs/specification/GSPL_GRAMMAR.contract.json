    {
      "lexeme": "lineage",
      "SyntaxKind": "KeywordLineage"
    },
    {
      "lexeme": "provenance",
      "SyntaxKind": "KeywordProvenance"
    },
    {
      "lexeme": "validation",
      "SyntaxKind": "KeywordValidation"
